{
  "_": "Cases both `core.ts` (the TypeScript targets) and `src/hook_run/logic.rs` (the agy runner) must decide alike. Run by crates/mars-schema/tests/typescript_hooks.rs and the unit tests of src/hook_run. `expect` of a `decide` or `fire` case holds only the answers both read: block and context. `expectRust` (permission, updatedInput) holds PreToolUse answers `core.ts` has no use for. A `fire` case scripts the finished command of each handler that runs, in order (an `async` handler takes none): a run states `status`, `stdout`, `stderr`, and `ok`/`why` when it did not exit.",
  "matcher": [
    {"pattern": null, "value": "Bash", "accepts": true},
    {"pattern": "", "value": "Bash", "accepts": true},
    {"pattern": "*", "value": "Bash", "accepts": true},
    {"pattern": "Bash", "value": "Bash", "accepts": true},
    {"pattern": "Bash", "value": "Read", "accepts": false},
    {"pattern": "ash", "value": "Bash", "accepts": false},
    {"pattern": "Bash|Edit", "value": "Edit", "accepts": true},
    {"pattern": "Bash, Edit", "value": "Edit", "accepts": true},
    {"pattern": "Bash,Edit", "value": "Write", "accepts": false},
    {"pattern": "Notebook-Edit", "value": "Notebook-Edit", "accepts": true},
    {"pattern": "^Bash$", "value": "Bash", "accepts": true},
    {"pattern": "^Bash$", "value": "BashX", "accepts": false},
    {"pattern": "Bash.*", "value": "BashX", "accepts": true},
    {"pattern": "mcp__.*", "value": "mcp__github__create", "accepts": true},
    {"pattern": "mcp__.*", "value": "Bash", "accepts": false},
    {"pattern": "mcp__(a|b)__.*", "value": "mcp__b__x", "accepts": true},
    {"pattern": "(", "value": "Bash", "accepts": false}
  ],
  "condition": [
    {"rule": "Bash", "tool": "Bash", "input": {"command": "ls"}, "holds": true},
    {"rule": "Bash", "tool": "Read", "input": {"file_path": "/a"}, "holds": false},
    {"rule": "Bash(*tmux*)", "tool": "Bash", "input": {"command": "tmux kill-server"}, "holds": true},
    {"rule": "Bash(*tmux*)", "tool": "Bash", "input": {"command": "ls"}, "holds": false},
    {"rule": "Bash(git *)", "tool": "Bash", "input": {"command": "git status"}, "holds": true},
    {"rule": "Bash(git *)", "tool": "Bash", "input": {"command": "ls"}, "holds": false},
    {"rule": "Bash(git push:*)", "tool": "Bash", "input": {"command": "git push origin"}, "holds": true},
    {"rule": "Bash(git push:*)", "tool": "Bash", "input": {"command": "git pull"}, "holds": false},
    {"rule": "Bash(*)", "tool": "Bash", "input": {"command": ""}, "holds": true},
    {"rule": "Bash(rm *)", "tool": "Bash", "input": {}, "holds": true},
    {"rule": "Edit|Write(*.ts)", "tool": "Write", "input": {"file_path": "/p/a.ts"}, "holds": true},
    {"rule": "Edit|Write(*.ts)", "tool": "Write", "input": {"file_path": "/p/a.py"}, "holds": false},
    {"rule": "Read(./.env)", "tool": "Read", "input": {"file_path": "/p/.env"}, "holds": true},
    {"rule": "Read(//etc/passwd)", "tool": "Read", "input": {"file_path": "/etc/passwd"}, "holds": true},
    {"rule": "Read(~/secrets/*)", "tool": "Read", "input": {"file_path": "/home/u/secrets/k"}, "holds": true},
    {"rule": "Read(src/*)", "tool": "Read", "input": {"file_path": "src\\a.rs"}, "holds": true}
  ],
  "decide": [
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "", "stderr": "", "why": "exit 0"}, "expect": {}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 2, "stdout": "", "stderr": " nope \n", "why": "exit 2"}, "expect": {"block": "nope"}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 2, "stdout": "", "stderr": "", "why": "exit 2"}, "expect": {"block": "Blocked by hook vec"}},
    {"event": "PostToolUse", "handler": {}, "run": {"ok": true, "status": 2, "stdout": "", "stderr": "x", "why": "exit 2"}, "expect": {}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 1, "stdout": "", "stderr": "boom", "why": "exit 1"}, "expect": {}},
    {"event": "PreToolUse", "handler": {"onFailure": "continue"}, "run": {"ok": true, "status": 1, "stdout": "", "stderr": "boom", "why": "exit 1"}, "expect": {}},
    {"event": "PreToolUse", "handler": {"onFailure": "block"}, "run": {"ok": true, "status": 1, "stdout": "", "stderr": " boom ", "why": "exit 1"}, "expect": {"block": "Blocked: hook vec failed (exit 1): boom"}},
    {"event": "PreToolUse", "handler": {"onFailure": "block"}, "run": {"ok": false, "status": null, "stdout": "", "stderr": "", "why": "timed out after 5s"}, "expect": {"block": "Blocked: hook vec failed (timed out after 5s)"}},
    {"event": "PostToolUse", "handler": {"onFailure": "block"}, "run": {"ok": true, "status": 1, "stdout": "", "stderr": "", "why": "exit 1"}, "expect": {}},
    {"event": "SessionStart", "handler": {"onFailure": "block"}, "run": {"ok": false, "status": null, "stdout": "", "stderr": "", "why": "killed"}, "expect": {}},
    {"event": "Stop", "handler": {"onFailure": "block"}, "run": {"ok": true, "status": 3, "stdout": "", "stderr": "", "why": "exit 3"}, "expect": {"block": "Blocked: hook vec failed (exit 3)"}},
    {"event": "UserPromptSubmit", "handler": {"onFailure": "block"}, "run": {"ok": true, "status": 2, "stdout": "", "stderr": "no prompts", "why": "exit 2"}, "expect": {"block": "no prompts"}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"why not\"}}", "stderr": "", "why": "exit 0"}, "expect": {"block": "why not"}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"deny\"}}", "stderr": "", "why": "exit 0"}, "expect": {"block": "Blocked by hook vec"}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"\"}}", "stderr": "", "why": "exit 0"}, "expect": {"block": "Blocked by hook vec"}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"decision\":\"block\",\"reason\":\"old style\"}", "stderr": "", "why": "exit 0"}, "expect": {}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "not json", "stderr": "", "why": "exit 0"}, "expect": {}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{broken", "stderr": "", "why": "exit 0"}, "expect": {}},
    {"event": "UserPromptSubmit", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "  {\"decision\":\"block\",\"reason\":\"refused\"}\n", "stderr": "", "why": "exit 0"}, "expect": {"block": "refused"}},
    {"event": "UserPromptSubmit", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"decision\":\"block\"}", "stderr": "", "why": "exit 0"}, "expect": {"block": "Blocked by hook vec"}},
    {"event": "Stop", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"decision\":\"block\",\"reason\":\"more\"}", "stderr": "", "why": "exit 0"}, "expect": {"block": "more"}},
    {"event": "Stop", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"decision\":\"approve\"}", "stderr": "", "why": "exit 0"}, "expect": {}},
    {"event": "SessionStart", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"hookSpecificOutput\":{\"additionalContext\":\"ctx\"}}", "stderr": "", "why": "exit 0"}, "expect": {"context": "ctx"}},
    {"event": "SessionStart", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"hookSpecificOutput\":{\"additionalContext\":\"\"}}", "stderr": "", "why": "exit 0"}, "expect": {}},
    {"event": "PreToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"hookSpecificOutput\":{\"additionalContext\":\"ignored\"}}", "stderr": "", "why": "exit 0"}, "expect": {}},
    {"event": "PostToolUse", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"hookSpecificOutput\":{\"additionalContext\":\"after\"}}", "stderr": "", "why": "exit 0"}, "expect": {"context": "after"}},
    {"event": "PostToolUseFailure", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"hookSpecificOutput\":{\"additionalContext\":\"failed\"}}", "stderr": "", "why": "exit 0"}, "expect": {"context": "failed"}},
    {"event": "UserPromptSubmit", "handler": {}, "run": {"ok": true, "status": 0, "stdout": "{\"decision\":\"block\",\"reason\":\"r\",\"hookSpecificOutput\":{\"additionalContext\":\"c\"}}", "stderr": "", "why": "exit 0"}, "expect": {"block": "r", "context": "c"}}
  ],
  "fire": [
    {"name": "first block wins", "event": "PreToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {"command": "ls"}}, "groups": [{"matcher": "Bash", "handlers": [{}, {}, {}]}], "runs": [{"status": 2, "stderr": "stop"}], "expect": {"block": "stop"}},
    {"name": "contexts before a block are joined, handlers after it never run", "event": "UserPromptSubmit", "groups": [{"matcher": null, "handlers": [{}, {}, {}]}], "runs": [{"status": 0, "stdout": "{\"hookSpecificOutput\":{\"additionalContext\":\"a\"}}"}, {"status": 0, "stdout": "{\"decision\": \"block\", \"reason\": \"r\"}"}], "expect": {"block": "r", "context": "a"}},
    {"name": "contexts of every handler are joined in order", "event": "PostToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {}}, "groups": [{"matcher": "Bash", "handlers": [{}]}, {"matcher": "*", "handlers": [{}]}], "runs": [{"status": 0, "stdout": "{\"hookSpecificOutput\":{\"additionalContext\":\"a\"}}"}, {"status": 0, "stdout": "{\"hookSpecificOutput\":{\"additionalContext\":\"b\"}}"}], "expect": {"context": "a\nb"}},
    {"name": "a group whose matcher does not match is skipped", "event": "PreToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {"command": "ls"}}, "groups": [{"matcher": "Edit", "handlers": [{}]}, {"matcher": "Bash", "handlers": [{}]}], "runs": [{"status": 2, "stderr": "only the second ran"}], "expect": {"block": "only the second ran"}},
    {"name": "an event with no matcher field runs every group", "event": "Stop", "groups": [{"matcher": "Whatever", "handlers": [{}]}], "runs": [{"status": 0, "stdout": "{\"decision\": \"block\", \"reason\": \"again\"}"}], "expect": {"block": "again"}},
    {"name": "a handler whose if does not hold is skipped", "event": "PreToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {"command": "ls"}}, "groups": [{"matcher": "Bash", "handlers": [{"if": "Bash(git *)"}, {}]}], "runs": [{"status": 2, "stderr": "second"}], "expect": {"block": "second"}},
    {"name": "an async handler is started and not awaited", "event": "PreToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {}}, "groups": [{"matcher": "Bash", "handlers": [{"async": true}, {}]}], "runs": [{"status": 2, "stderr": "sync"}], "expect": {"block": "sync"}},
    {"name": "a failing handler blocks only on a blocking event with onFailure block", "event": "Stop", "groups": [{"matcher": null, "handlers": [{"onFailure": "block"}]}], "runs": [{"ok": false, "status": null, "why": "timed out after 1s", "stderr": "slow"}], "expect": {"block": "Blocked: hook vec failed (timed out after 1s): slow"}},
    {"name": "a failing handler is ignored without onFailure block", "event": "Stop", "groups": [{"matcher": null, "handlers": [{}]}], "runs": [{"status": 1}], "expect": {}},
    {"name": "a failing handler on a non-blocking event is ignored", "event": "PostToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {}}, "groups": [{"matcher": "Bash", "handlers": [{"onFailure": "block"}]}], "runs": [{"status": 1}], "expect": {}},
    {"name": "ask beats allow", "event": "PreToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {}}, "groups": [{"matcher": "Bash", "handlers": [{}, {}, {}]}], "runs": [{"status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"allow\"}}"}, {"status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"ask\"}}"}, {"status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"allow\"}}"}], "expect": {}, "expectRust": {"permission": "ask"}},
    {"name": "a deny beats an earlier allow and drops its updatedInput", "event": "PreToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {}}, "groups": [{"matcher": "Bash", "handlers": [{}, {}]}], "runs": [{"status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"allow\",\"updatedInput\":{\"command\":\"x\"}}}"}, {"status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"no\"}}"}], "expect": {"block": "no"}, "expectRust": {"permission": null, "updatedInput": null}},
    {"name": "updatedInput of every allow is merged", "event": "PreToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {}}, "groups": [{"matcher": "Bash", "handlers": [{}, {}]}], "runs": [{"status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"allow\",\"updatedInput\":{\"a\":1}}}"}, {"status": 0, "stdout": "{\"hookSpecificOutput\":{\"permissionDecision\":\"allow\",\"updatedInput\":{\"b\":2,\"a\":3}}}"}], "expect": {}, "expectRust": {"permission": "allow", "updatedInput": {"a": 3, "b": 2}}},
    {"name": "updatedInput without a permission answer is ignored", "event": "PreToolUse", "matcher": "Bash", "tool": {"name": "Bash", "input": {}}, "groups": [{"matcher": "Bash", "handlers": [{}]}], "runs": [{"status": 0, "stdout": "{\"hookSpecificOutput\":{\"updatedInput\":{\"a\":1}}}"}], "expect": {}, "expectRust": {"permission": null, "updatedInput": null}}
  ]
}
