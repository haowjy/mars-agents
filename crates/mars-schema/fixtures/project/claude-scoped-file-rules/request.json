{
  "host": "claude",
  "rules": [
    {
      "capability": "write",
      "pattern": "src/**",
      "action": "allow"
    },
    {
      "capability": "edit",
      "pattern": "src/**",
      "action": "ask"
    },
    {
      "capability": "read",
      "pattern": "src/**",
      "action": "deny"
    }
  ]
}
