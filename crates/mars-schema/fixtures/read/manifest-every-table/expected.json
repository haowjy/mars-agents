  "fields": {
    "name": "every-table",
    "version": "1.2.3",
    "description": "A manifest that uses every table Mars reads.",
    "schema": 1,
    "uses-providers": [
      "anthropic"
    ],
    "requires-mars": ">=0.34.0",
    "tools": {
      "bash(git push *)": "ask"
    }
  },
  "body": null,
  "diagnostics": [
    {
      "code": "field.unknown",
      "severity": "info",
      "path": [
        "settings",
        "unknown_setting"
      ],
      "message": "[settings] unknown key `unknown_setting` is not read by Mars v{version} (a typo, or a key from a newer Mars); it stays in the file"
    },
    {
      "code": "field.unknown",
      "severity": "info",
      "path": [
        "dependencies",
        "base",
        "mystery"
      ],
      "message": "[dependencies.base] unknown key `mystery` is not read by Mars v{version} (a typo, or a key from a newer Mars); it stays in the file"
    }
  ],
  "dependencies": {
    "base": {
      "url": "https://github.com/example/base",
      "version": "^1.0",
      "agents": [
        "coder"
      ],
      "mystery": true
    }
  },
  "local-dependencies": {
    "helper": {
      "path": "../helper"
    }
  },
  "plugin": {
    "dir": "plugin"
  },
  "settings": {
    "targets": [
      ".claude",
      ".codex"
    ],
    "models_cache_ttl_hours": 12,
    "min_mars_version": ">=0.34.0",
    "default_harness": "claude",
    "default_model": "sonnet",
    "default_network": "allow",
    "network-allow": [
      "api.example.com"
    ],
    "network-deny": [
      "evil.example.com"
    ],
    "tools": {
      "bash(rm *)": "deny"
    },
    "harness_order": [
      "claude",
      "codex"
    ],
    "provider_order": [
      "anthropic",
      "openai"
    ],
    "catalog_providers": [
      "anthropic",
      "openai"
    ],
    "agent_emission": "never",
    "meridian": {
      "agent_copy": {
        "harnesses": [
          "claude"
        ],
        "include_fanout": true
      },
      "fanout": {
        "agents": [
          "orchestrator"
        ]
      }
    },
    "model-policies": [
      {
        "match": {
          "alias": "opus"
        },
        "override": {
          "effort": "high"
        }
      }
    ]
  },
  "models": {
    "sonnet": {
      "harness": "claude",
      "description": "Everyday work.",
      "prompting": "Be brief.",
      "default_effort": "high",
      "autocompact": 200000,
      "autocompact_pct": 80,
      "provider": "anthropic",
      "match": [
        "claude*sonnet*"
      ],
      "exclude": [
        "*:*"
      ]
    },
    "pinned": {
      "model": "gpt-5.5"
    },
    "pinned-widened": {
      "model": "claude-opus-4-1",
      "match": [
        "claude*opus*"
      ],
      "exclude": [
        "*:*"
      ]
    }
  },
  "agents": {
    "coder": {
      "description": "Writes code.",
      "model": "sonnet",
      "harness": "claude",
      "effort": "medium",
      "approval": "auto",
      "sandbox": "workspace-write",
      "network": "allow",
      "network-allow": [
        "docs.example.com"
      ],
      "model-invocable": true,
      "user-invocable": false,
      "tools": {
        "bash(git *)": "allow"
      },
      "model-policies": [
        {
          "match": {
            "model": "gpt-5.5"
          },
          "override": {
            "effort": "low"
          }
        }
      ]
    }
  },
  "skills": {
    "review": {
      "description": "Reviews a diff.",
      "model-invocable": false,
      "user-invocable": true
    }
  }
}
